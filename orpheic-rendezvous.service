# The Orpheic rendezvous — the one always-reachable point, doing as little as possible.
# See the header of rendezvous.py for what it does and what it deliberately cannot know.
[Unit]
Description=Orpheic rendezvous (find-your-desktop — introductions only)
After=network-online.target
Wants=network-online.target
# Never park in "failed" from a start-storm: a co-tenant that squats 8750/8751/8752 must not be
# able to make systemd give up (default: 5 starts / 10s). A bind-blocked service keeps retrying
# (RestartSec) and screaming in the journal instead of dying silently.
StartLimitIntervalSec=0

[Service]
# Lives OUTSIDE the webroot: the service is code, not web content, and /var/www/orpheic.com
# now holds only the served site. Its own directory under /opt keeps the two from ever
# leaking into each other. ProtectSystem=strict still leaves /opt readable — the service
# writes nothing to disk.
ExecStart=/usr/bin/python3 /opt/orpheic-rendezvous/rendezvous.py
Restart=always
RestartSec=5
# A DEDICATED user, not www-data: on this shared box www-data is nginx + every co-tenant web
# app, and a same-UID process can SIGKILL this one or read its /proc. Its own user isolates it.
User=orpheic-rv
Group=orpheic-rv
Environment=RV_CONTROL_PORT=8750
Environment=RV_RELAY_PORT=8751
Environment=RV_OBS_PORT=8752
# The Phase F5 policy (remote-streaming.md §5.6): this server INTRODUCES — it meets,
# observes and orders punches — and will not carry one byte of anyone's music. Delete
# this line to re-hang the relay safety net (phones are told either way and behave).
Environment=RV_RELAY=off
# Loopback is NOT rate-limit-exempt in prod: the exemption exists only to exercise the caps
# from a local test. Without this, ANY local process (any co-tenant, any UID — loopback needs
# no privilege) registers 5000 junk keys and locks every real desktop out of remote listening.
Environment=RV_LIMIT_LOCAL=1
# It needs nothing of the system's: no privileges, no home, no writable filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Extra confinement — it only needs two UDP/TCP socket families and no capabilities at all.
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
