# findd — the heartbeat catalog of docs/design/findability.md §12–§13 (UDP 8753). Desktops beat to it
# from their QUIC sockets; the rendezvous asks it "where is X?" and "tell X a phone is coming" over a
# local Unix socket. Memory only: a restart forgets every row and every desktop re-joins on its own.
[Unit]
Description=Orpheic findd (desktop heartbeats — where each desktop is, right now)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/orpheic-findd/findd 8753 /etc/orpheic-findd/server.key /run/orpheic-findd/ctl.sock
Restart=always
RestartSec=2
# FINDD_PUBLIC = this server's own public addresses ("ip:8753,[ip6]:8753"): a desktop's handshake signed for any OTHER address
# was relayed (DNS spoofing) — refused. It lives ON the box, not in the repository (server/DEPLOY.md, step 2).
EnvironmentFile=/etc/orpheic-findd/env
# The SAME user as the rendezvous: the control socket is 0600, and only the rendezvous may ask or order.
User=orpheic-rv
Group=orpheic-rv
# /run/orpheic-findd holds the control socket. Preserved across restarts: the rendezvous bind-mounts it
# at ITS start (ReadWritePaths), and a recreated directory would be invisible to it.
RuntimeDirectory=orpheic-findd
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# 500 000 rows × ~650 B ≈ 325 MB at the default max_rows (findability.md §13.3).
MemoryHigh=400M
MemoryMax=512M
LimitNOFILE=1024
TasksMax=8
SystemCallArchitectures=native
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

[Install]
WantedBy=multi-user.target
